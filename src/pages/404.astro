---
// Not found: the same notebook, with the way back.
import Layout from "@/components/Layout.astro";
---
<Layout title="Page not found">
  <section class="row hero lost" aria-labelledby="lost-title">
    <div class="entry">
      <span class="stamp num">404</span>
      <div class="body">
        <h1 id="lost-title">There is no entry on this page.</h1>
        <p class="lede">The link may be old, or the page was never written. Everything that exists is one step away.</p>
        <div class="actions">
          <a class="btn btn-primary" href="/">Back to home</a>
          <a class="btn" href="/blog">Writing</a>
          <button type="button" class="btn" data-open-index>Open the index</button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelector("[data-open-index]")?.addEventListener("click", () => dispatchEvent(new CustomEvent("index:open")));
</script>
