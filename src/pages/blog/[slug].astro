---
// One Post: TOC from its h2s with scrollspy, anchored headings, captioned code with copy, prev/next.
import Layout from "@/components/Layout.astro";
import { getPosts, postHref, readingMinutes, type Post } from "@/lib/content";
import { isoDay } from "@/lib/format";
import { render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getPosts();
  // Newest first, so the older Post is the next one in the list.
  return posts.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, newer: posts[i - 1], older: posts[i + 1] } }));
}

const { entry, newer, older } = Astro.props as { entry: Post; newer?: Post; older?: Post };
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const date = isoDay(entry.data.date);
---
<Layout title={entry.data.title} description={entry.data.summary}>
  <div class="row" data-pagefind-body data-pagefind-meta="kind:Post">
    <div class="row">
      <p data-pagefind-ignore><a class="back" href="/blog">Back to writing</a></p>
      <header class="post-head">
        <h1>{entry.data.title}</h1>
        <p class="meta">
          <time datetime={date}>{date}</time>
          <span><span class="num">{readingMinutes(entry.body)}</span> min read</span>
          {entry.data.draft && <span class="sample">Draft, shown in dev only</span>}
        </p>
      </header>
    </div>

    <div class="post">
      {toc.length > 0 && (
        <nav class="toc" aria-label="On this page" data-pagefind-ignore>
          <p>On this page</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
      <article class="prose">
        <Content />
      </article>
    </div>
  </div>

  <nav class="post-end" aria-label="Post">
    <a class="back" href="/blog">All writing</a>
    {(newer || older) && (
      <p class="pager">
        {older && <a href={postHref(older)} rel="prev">Older Post: {older.data.title}</a>}
        {newer && <a href={postHref(newer)} rel="next">Newer Post: {newer.data.title}</a>}
      </p>
    )}
  </nav>
</Layout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((h): h is HTMLElement => !!h);
  const mark = (id: string) => links.forEach((a) => a.setAttribute("aria-current", String(decodeURIComponent(a.hash.slice(1)) === id)));
  // Scrollspy: the current section is the last heading above a third of the viewport.
  let queued = false;
  const update = () => {
    queued = false;
    const line = innerHeight / 3;
    let cur = heads[0];
    for (const h of heads) if (h.getBoundingClientRect().top <= line) cur = h;
    if (cur) mark(cur.id);
  };
  if (heads.length) {
    addEventListener("scroll", () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
