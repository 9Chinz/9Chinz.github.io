---
// Home: hero, Selected Work, Experience, Latest Writing (only once a Post is published), Contact.
// A Selected Work entry links each destination once: its Case Study as a text link, its live page as
// the preview (compact unless the entry has a Case Study) or a "Live site" link. Titles stay plain text.
import Layout from "@/components/Layout.astro";
import CopyButton from "@/components/CopyButton.astro";
import Sketch from "@/components/Sketch.astro";
import Unfurl from "@/components/Unfurl.astro";
import { getPosts, getProfile, getWork, postHref, readingMinutes } from "@/lib/content";
import { duration, end, isoDay, lowerFirst, monthsBetween, plain, stripMarkup } from "@/lib/format";
import { sized, srcset, webp } from "@/lib/image";

const [profile, work, posts] = await Promise.all([getProfile(), getWork(), getPosts()]);
const latest = posts.slice(0, 3);

// Selected Work comes in two groups, each in the entries' own order. Election coverage carries the previews and
// the Case Study; Other work has no live page to show, so its entries sit closer together.
const groups = [
  { key: "elections", title: "Election coverage" },
  { key: "other", title: "Other work" },
].map((g) => ({ ...g, items: work.filter((w) => w.data.group === g.key) })).filter((g) => g.items.length > 0);

// The hero carries one sentence: the first of the Profile summary. The rest closes Contact.
const [lede, ...restSummary] = profile.summary.split(/(?<=\.)\s+/);
---
<Layout title={`${profile.name}, ${profile.role}`} home>
  <section class="row hero" aria-labelledby="hero-title">
    <h1 id="hero-title">{profile.headline}</h1>
    <p class="lede">{lede}</p>
    <div class="actions">
      <a class="btn btn-primary" href={profile.links.resume}>Resume (PDF)</a>
      <a class="btn" href={profile.links.github}>GitHub</a>
      <a class="btn" href={profile.links.linkedin}>LinkedIn</a>
      <CopyButton text={profile.email} label="Copy email" />
    </div>
    <div class="hero-id">
      <picture class="portrait">
        <source srcset={srcset([[sized(profile.photo.src, 256), 256], [webp(profile.photo.src), 400]])} sizes="(max-width: 60rem) 72px, 128px" type="image/webp" />
        <img src={profile.photo.src} srcset={srcset([[sized(profile.photo.src, 256, "jpg"), 256], [profile.photo.src, 400]])} sizes="(max-width: 60rem) 72px, 128px" alt={profile.photo.alt} width="400" height="400" decoding="async" />
      </picture>
      <p class="hero-where"><span>{profile.location}</span> <span>{profile.availability}</span></p>
    </div>
    <Sketch sketch={profile.sketch} />
  </section>

  <section class="row section" id="work" aria-labelledby="work-title" data-pagefind-body data-pagefind-meta="kind:Selected Work">
    <h2 class="section-head" id="work-title">Selected Work</h2>
    {groups.map((g) => (
      <div class="row work-group">
        <h3 class="group-head" id={`work-${g.key}`}>{g.title}</h3>
        <ul class:list={["row list", g.key === "other" && "list-near"]}>
          {g.items.map((w) => {
            const d = w.data;
            const caseStudy = d.caseStudy ? `/work/${w.id}` : undefined;
            return (
              <li class:list={["entry", caseStudy && "entry-lead"]}>
                <time class="stamp" datetime={d.year}>{d.year}</time>
                <div class="body">
                  <h4 id={`work-${w.id}`}>{d.title}</h4>
                  <p class="meta">{d.client}, {lowerFirst(d.role)}</p>
                  <p class="desc">{d.summary}</p>
                  {(caseStudy || (d.url && !d.og)) && (
                    <p class="more">
                      {caseStudy && <a href={caseStudy}>Read the case study</a>}
                      {d.url && !d.og && <a href={d.url}>Live site</a>}
                    </p>
                  )}
                  {d.url && d.og && <Unfurl url={d.url} og={d.og} title={d.title} alt={d.ogAlt ?? `Share image of the live ${d.title} page`} compact={!caseStudy} />}
                  {d.photos?.map((ph) => (
                    <figure class="onsite">
                      <picture>
                        <source srcset={srcset([[sized(ph.src, 640), 640], [sized(ph.src, 800), 800], [sized(ph.src, 1200), 1200], [webp(ph.src), ph.width]])} sizes="(max-width: 22rem) calc(100vw - 32px), 20rem" type="image/webp" />
                        <img src={ph.src} srcset={srcset([[sized(ph.src, 800, "jpg"), 800], [ph.src, ph.width]])} sizes="(max-width: 22rem) calc(100vw - 32px), 20rem" alt={ph.alt} width={ph.width} height={ph.height} loading="lazy" decoding="async" />
                      </picture>
                      <figcaption>{ph.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>

  <section class="row section" id="experience" aria-labelledby="exp-title">
    <h2 class="section-head" id="exp-title">Experience</h2>
    <ol class="row list">
      {profile.experience.map((x) => {
        const first = x.roles[x.roles.length - 1];
        const last = x.roles[0];
        const [lead, ...rest] = x.highlights;
        const total = duration(monthsBetween(first.start, last.end));
        return (
          <li class="entry">
            <p class="stamp">
              <time datetime={first.start}>{first.start}</time>
              <span class="to"> to {last.end === "Present" ? end(last.end) : <time datetime={last.end}>{last.end}</time>}</span>
              <span class="dur">{total}</span>
            </p>
            <div class="body">
              <h3>{x.org}</h3>
              <p class="meta">{plain(x.place)}</p>
              <ul class="roles">
                {x.roles.map((r) => (
                  <li>
                    <span>{r.title}</span>
                    {x.roles.length > 1 && (
                      <span class="meta"><time datetime={r.start}>{r.start}</time> to {r.end === "Present" ? end(r.end) : <time datetime={r.end}>{r.end}</time>}, {duration(monthsBetween(r.start, r.end))}</span>
                    )}
                  </li>
                ))}
              </ul>
              <ul class="bullets">
                <li>{stripMarkup(lead)}</li>
              </ul>
              {rest.length > 0 && (
                <details class="more-hl">
                  <summary>{rest.length === 1 ? "One more highlight" : `${rest.length} more highlights`}</summary>
                  <ul class="bullets">
                    {rest.map((h) => <li>{stripMarkup(h)}</li>)}
                  </ul>
                </details>
              )}
            </div>
          </li>
        );
      })}
    </ol>
    <p class="endnote">Education, the full stack list and dates are in the <a href={profile.links.resume}>resume (PDF)</a>.</p>
  </section>

  {latest.length > 0 && (
    <section class="row section" id="writing" aria-labelledby="writing-title">
      <h2 class="section-head" id="writing-title">Latest Writing</h2>
      <ul class="row list list-tight">
        {latest.map((p) => (
          <li class="entry">
            <time class="stamp" datetime={isoDay(p.data.date)}>{isoDay(p.data.date)}</time>
            <div class="body">
              <h3><a href={postHref(p)}>{p.data.title}</a></h3>
              <p class="meta"><span class="num">{readingMinutes(p.body)}</span> min read{p.data.draft && ", draft"}</p>
            </div>
          </li>
        ))}
      </ul>
      {posts.length > latest.length && <p class="endnote"><a href="/blog">All writing</a></p>}
    </section>
  )}

  <section class="row section contact" id="contact" aria-labelledby="contact-title">
    <div class="contact-sheet">
      <h2 class="section-head" id="contact-title">Contact</h2>
      <p class="lede">{profile.availability}. {restSummary.join(" ")}</p>
      <div class="email">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <CopyButton text={profile.email} label="Copy email" ariaLabel="Copy email address" />
      </div>
      <p class="links">
        <a href={profile.links.github}>GitHub</a>
        <a href={profile.links.linkedin}>LinkedIn</a>
        <a href={profile.links.resume}>Resume (PDF)</a>
      </p>
    </div>
  </section>
</Layout>
