---
// PROTOTYPE. Floating switcher between design directions. Dev builds only.
// Swaps the /prototype/<v>/ segment and keeps the rest of the path.
const variants = [
  { key: "a", name: "Engineer's notebook" },
  { key: "b", name: "Systems console" },
  { key: "c", name: "Editorial magazine" },
  { key: "d", name: "Playful interactive" },
];
const pages = [
  { path: "", name: "Home" },
  { path: "work/local-election-68", name: "Case study" },
  { path: "blog/sample-post", name: "Post" },
];
const show = import.meta.env.DEV;
---
{show && (
  <div id="proto-switcher" data-variants={JSON.stringify(variants)} data-pages={JSON.stringify(pages)}>
    <button type="button" data-dir="-1" aria-label="Previous direction">‹</button>
    <span data-label></span>
    <button type="button" data-dir="1" aria-label="Next direction">›</button>
    <span class="sep"></span>
    <select aria-label="Page" data-page></select>
  </div>
)}
<style>
  #proto-switcher {
    all: initial;
    position: fixed; z-index: 2147483000; left: 50%; bottom: 16px; transform: translateX(-50%);
    display: flex; align-items: center; gap: 6px; padding: 6px 8px;
    background: #fff; color: #000; border: 2px solid #000; border-radius: 999px;
    font: 600 13px/1 system-ui, sans-serif; box-shadow: 0 6px 24px rgb(0 0 0 / 0.25);
  }
  #proto-switcher button, #proto-switcher select {
    all: unset; cursor: pointer; padding: 6px 10px; border-radius: 999px; font: inherit;
  }
  #proto-switcher button:hover, #proto-switcher select:hover { background: #eee; }
  #proto-switcher button:focus-visible, #proto-switcher select:focus-visible { outline: 2px solid #06f; }
  #proto-switcher [data-label] { min-width: 180px; text-align: center; }
  #proto-switcher .sep { width: 1px; height: 18px; background: #ccc; }
</style>
<script>
  const el = document.getElementById("proto-switcher");
  if (el) {
    const variants: { key: string; name: string }[] = JSON.parse(el.dataset.variants!);
    const pages: { path: string; name: string }[] = JSON.parse(el.dataset.pages!);
    const m = location.pathname.match(/^\/prototype\/([a-d])\/?(.*)$/);
    const cur = m?.[1] ?? "a";
    const rest = (m?.[2] ?? "").replace(/\/$/, "");
    const i = variants.findIndex((v) => v.key === cur);
    el.querySelector("[data-label]")!.textContent = `${cur.toUpperCase()} · ${variants[i].name}`;
    const go = (v: string, p: string) => location.assign(`/prototype/${v}/${p}${location.hash}`);
    const step = (d: number) => go(variants[(i + d + variants.length) % variants.length].key, rest);
    el.querySelectorAll<HTMLButtonElement>("button[data-dir]").forEach((b) =>
      b.addEventListener("click", () => step(Number(b.dataset.dir))),
    );
    const sel = el.querySelector<HTMLSelectElement>("[data-page]")!;
    for (const p of pages) sel.add(new Option(p.name, p.path, false, p.path === rest));
    sel.addEventListener("change", () => go(cur, sel.value));
    addEventListener("keydown", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("input, textarea, select, [contenteditable]") || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });
  }
</script>
